#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct NodeAccumData
{
    int mass;
    int momentum_x;
    int momentum_y;
    int padding;
};

struct NodeData
{
    vec4 mass_vel;
};

layout(std430, binding = 1) readonly buffer NodeAccumBuffer
{
    NodeAccumData accum_nodes[];
};

layout(std430, binding = 2) buffer NodeBuffer
{
    NodeData nodes[];
};

layout(push_constant) uniform PushConstants
{
    int grid_width;
    int grid_height;
    int particle_count;
    float cell_size;
    float dt;
    float gravity_y;
} pc;

const float MASS_SCALE = 10000.0;
const float MOMENTUM_SCALE = 4096.0;

void main()
{
    const uint node_index = gl_GlobalInvocationID.x;
    const uint node_count = uint(max(pc.grid_width * pc.grid_height, 0));
    if (node_index >= node_count)
    {
        return;
    }

    const int node_x = int(node_index % uint(pc.grid_width));
    const int node_y = int(node_index / uint(pc.grid_width));
    const NodeAccumData accum = accum_nodes[node_index];
    const float mass = float(accum.mass) / MASS_SCALE;
    vec2 velocity = vec2(0.0);

    if (mass > 0.0)
    {
        velocity = vec2(float(accum.momentum_x), float(accum.momentum_y)) / MOMENTUM_SCALE;
        velocity /= mass;
        velocity.y += pc.gravity_y * pc.dt;

        if ((node_x == 0 && velocity.x < 0.0) || (node_x == pc.grid_width - 1 && velocity.x > 0.0))
        {
            velocity.x = 0.0;
        }
        if ((node_y == 0 && velocity.y < 0.0) || (node_y == pc.grid_height - 1 && velocity.y > 0.0))
        {
            velocity.y = 0.0;
        }
    }
    else
    {
        velocity = vec2(0.0);
    }

    nodes[node_index].mass_vel = vec4(mass, velocity.x, velocity.y, 0.0);
}
