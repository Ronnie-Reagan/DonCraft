#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct ParticleData
{
    vec4 pos_vel;
    vec4 mass_pad;
};

struct NodeAccumData
{
    int mass;
    int momentum_x;
    int momentum_y;
    int padding;
};

struct StatsData
{
    int total_mass;
    int padding0;
    int padding1;
    int padding2;
};

layout(std430, binding = 0) readonly buffer ParticleBuffer
{
    ParticleData particles[];
};

layout(std430, binding = 1) buffer NodeAccumBuffer
{
    NodeAccumData nodes[];
};

layout(std430, binding = 3) buffer StatsBuffer
{
    StatsData stats;
};

layout(push_constant) uniform PushConstants
{
    int grid_width;
    int grid_height;
    int particle_count;
    float cell_size;
    float dt;
    float gravity_y;
} pc;

const float MASS_SCALE = 10000.0;
const float MOMENTUM_SCALE = 4096.0;

uint node_index(const int x, const int y)
{
    return uint(y * pc.grid_width + x);
}

void accumulate_to_node(const uint index, const float weight, const float particle_mass, const vec2 velocity)
{
    if (weight <= 0.0)
    {
        return;
    }

    const float weighted_mass = particle_mass * weight;
    atomicAdd(nodes[index].mass, int(round(weighted_mass * MASS_SCALE)));
    atomicAdd(nodes[index].momentum_x, int(round(weighted_mass * velocity.x * MOMENTUM_SCALE)));
    atomicAdd(nodes[index].momentum_y, int(round(weighted_mass * velocity.y * MOMENTUM_SCALE)));
}

void main()
{
    const uint particle_index = gl_GlobalInvocationID.x;
    if (particle_index >= uint(max(pc.particle_count, 0)))
    {
        return;
    }

    const ParticleData particle = particles[particle_index];
    const vec2 position = particle.pos_vel.xy;
    const vec2 velocity = particle.pos_vel.zw;
    const float particle_mass = particle.mass_pad.x;
    const vec2 grid = position / pc.cell_size;
    const int base_x = clamp(int(floor(grid.x)), 0, pc.grid_width - 2);
    const int base_y = clamp(int(floor(grid.y)), 0, pc.grid_height - 2);
    const float fx = clamp(grid.x - float(base_x), 0.0, 1.0);
    const float fy = clamp(grid.y - float(base_y), 0.0, 1.0);

    accumulate_to_node(node_index(base_x, base_y), (1.0 - fx) * (1.0 - fy), particle_mass, velocity);
    accumulate_to_node(node_index(base_x + 1, base_y), fx * (1.0 - fy), particle_mass, velocity);
    accumulate_to_node(node_index(base_x, base_y + 1), (1.0 - fx) * fy, particle_mass, velocity);
    accumulate_to_node(node_index(base_x + 1, base_y + 1), fx * fy, particle_mass, velocity);
    atomicAdd(stats.total_mass, int(round(particle_mass * MASS_SCALE)));
}
