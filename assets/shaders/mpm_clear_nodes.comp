#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct NodeAccumData
{
    int mass;
    int momentum_x;
    int momentum_y;
    int padding;
};

struct StatsData
{
    int total_mass;
    int padding0;
    int padding1;
    int padding2;
};

layout(std430, binding = 1) buffer NodeAccumBuffer
{
    NodeAccumData nodes[];
};

layout(std430, binding = 3) buffer StatsBuffer
{
    StatsData stats;
};

layout(push_constant) uniform PushConstants
{
    int grid_width;
    int grid_height;
    int particle_count;
    float cell_size;
    float dt;
    float gravity_y;
} pc;

void main()
{
    const uint node_index = gl_GlobalInvocationID.x;
    const uint node_count = uint(max(pc.grid_width * pc.grid_height, 0));
    if (node_index < node_count)
    {
        nodes[node_index].mass = 0;
        nodes[node_index].momentum_x = 0;
        nodes[node_index].momentum_y = 0;
        nodes[node_index].padding = 0;
    }

    if (node_index == 0u)
    {
        stats.total_mass = 0;
        stats.padding0 = 0;
        stats.padding1 = 0;
        stats.padding2 = 0;
    }
}
